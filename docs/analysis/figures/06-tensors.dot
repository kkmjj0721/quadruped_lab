digraph G {
  graph [rankdir=TB, nodesep=0.20, ranksep=0.26, fontname="Noto Sans CJK SC", fontsize=14,
         label="图6  张量布局：谁看得到什么（盲策略边界）", labelloc="t"];
  node [fontname="Noto Sans CJK SC", fontsize=9, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#3f6fa8"];
  edge [fontname="Noto Sans CJK SC", fontsize=8, color="#4a4a4a"];

  node [shape=plaintext, style="", fontsize=8];
  obs [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="6" BGCOLOR="#e8f5e9">观测单帧 45 维（task.observe；训练加均匀噪声，播放不加）</TD></TR>
      <TR><TD>ω_body</TD><TD>重力投影</TD><TD>q − q_default + 编码器偏置</TD><TD>q̇</TD><TD>上一动作</TD><TD>命令</TD></TR>
      <TR><TD>3</TD><TD>3</TD><TD>12</TD><TD>12</TD><TD>12</TD><TD>3</TD></TR>
      <TR><TD COLSPAN="6" BGCOLOR="#fff3e0">× 5 帧（旧→新）= 225 维历史；reset 时用首帧重复填满。不含线速度 / 地形 / 接触 / 摩擦力 / COM / 位姿</TD></TR>
    </TABLE>>];

  priv [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="7" BGCOLOR="#e3f2fd">特权特征 179 维（task.privileged，仅 critic）</TD></TR>
      <TR><TD>物理状态 70</TD><TD>上一动作 12</TD><TD>命令 3</TD><TD>命令计时 1</TD><TD>地形扫描 77</TD><TD>摩擦/COM/编码器偏置 16</TD><TD>= 179</TD></TR>
    </TABLE>>];

  mi [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="6" BGCOLOR="#f3e5f5">世界模型输入 187 维（task.model_input，用于学习 73 维增量）</TD></TR>
      <TR><TD>物理状态 70</TD><TD>本步动作 12</TD><TD>上一动作 12</TD><TD>摩擦+COM+偏置 16</TD><TD>地形扫描 77</TD><TD>= 187</TD></TR>
    </TABLE>>];

  phys [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2">
      <TR><TD COLSPAN="11" BGCOLOR="#fdf6e3">physical 73 = 70 维机器人状态（reference_state.py 切片）+ 3 维平面位姿</TD></TR>
      <TR><TD>高度 1</TD><TD>重力 3</TD><TD>heading 线速度 3</TD><TD>体角速度 3</TD><TD>关节偏移 12</TD><TD>关节速度 12</TD><TD>髋 12</TD><TD>膝 12</TD><TD>足 12</TD><TD>xy 2</TD><TD>yaw 1</TD></TR>
      <TR><TD>0</TD><TD>1</TD><TD>4</TD><TD>7</TD><TD>10</TD><TD>22</TD><TD>34</TD><TD>46</TD><TD>58</TD><TD>70</TD><TD>72</TD></TR>
    </TABLE>>];

  sep [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="8" BGCOLOR="#eeeeee">context 26（每环境真实随机化参数，随 reset 重读）与 memory 14</TD></TR>
      <TR><TD>摩擦 1</TD><TD>编码器偏置 12</TD><TD>COM 3</TD><TD>原点 3</TD><TD>命令范围 6</TD><TD>站立概率 1</TD><TD>上一动作 12</TD><TD>时钟+命令计时 2</TD></TR>
      <TR><TD COLSPAN="6">context[0:26]</TD><TD COLSPAN="2">memory[0:14]</TD></TR>
    </TABLE>>];

  a1 [label="actor 只吃 history（225）；没有线速度、地形、接触 → 盲", fillcolor="#e8f5e9"];
  a2 [label="critic 吃 179 维特权；只在想象回报上拟合，绝不进入部署图", fillcolor="#e3f2fd"];
  a3 [label="world model 吃 187 维：知道自己脚下的地形与随机化参数，可微；部署时不导出", fillcolor="#f3e5f5"];
  obs -> a1 [style=dashed]; priv -> a2 [style=dashed]; mi -> a3 [style=dashed];
  mi -> phys [style=dotted, label="70 由 physical 提供"];
  phys -> priv [style=dotted];
  sep -> mi [style=dotted, label="16 维 context"];
}
