digraph G {
  graph [rankdir=TB, nodesep=0.28, ranksep=0.30, fontname="Noto Sans CJK SC", fontsize=14,
         label="图3  SuperMimic 单轮训练迭代（SingleRunner.learn）", labelloc="t"];
  node [fontname="Noto Sans CJK SC", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#3f6fa8"];
  edge [fontname="Noto Sans CJK SC", fontsize=8, color="#4a4a4a"];

  start [label="iteration += 1 前\ntorch.cuda.synchronize + 计时", shape=box, style="rounded,filled", fillcolor="#f5f5f5"];

  subgraph cluster_collect {
    label="A 采集（真实 MuJoCo Warp 步进，no_grad）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=10;
    c1 [label="steps = 16（replay 空）否则 1\n每步推进 1 个控制步 = 4 物理步 × 5 ms"];
    c2 [label="a = π(history) + noise\n前 25% 环境 OU(θ=2, σ=0.3)，其余 N(0, 0.1²)"];
    c3 [label="adapter.step：物理→73 维终态→六项奖励→课程→部分 reset"];
    c4 [label="replay.add(current, obs, a, result, age)\nmodel.update_stats(current, a, next)\nactor.update_statistics(history)"];
    c5 [label="history ← 追加 observe(next, noisy)\ndone 行整段替换为首帧；ages 归零或 +1"];
    c1 -> c2 -> c3 -> c4 -> c5;
  }

  subgraph cluster_wm {
    label="B 世界模型拟合（wm_updates = 2）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=10;
    w1 [label="采样 2048 条 8 步窗口\n1024 均匀 + 512 优先 + 512 归档（归档仅在有数据时）"];
    w2 [label="优先分 = replay_priority：\n接触翻转 / 腾空 / 4×跌倒加权"];
    w3 [label="loss：8 步自回归，逐步 target 归一化\n物理状态回喂预测，记忆/命令用记录值，终止后 valid=0"];
    w1 -> w2 [style=dashed, label="仅优先段"];
    w2 -> w3 [style=dashed];
  }

  gate [label="replay.ready(wm_window=8)？", shape=diamond, fillcolor="#fff8e1"];
  ctrl [label="iteration > policy_start(300)\n且 未超过 actor_frozen_until？", shape=diamond, fillcolor="#fff8e1"];

  subgraph cluster_ctl {
    label="C 想象策略改进（improve，模型与 critic 冻结）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=10;
    i1 [label="MoE 负载均衡损失 0.01 × MSE(门控均值, 1/8)\n整批 8192 种子一次性 backward"];
    i2 [label="sample_seeds(8192)：取 state + 5 帧历史\n（history 长度受 age 限制，reset 后重复首帧）"];
    i3 [label="分 256 微批做 32 步想象 BPTT\nreward = dt Σ scale·term，survival 用 soft_termination\n末尾 γ³²·survival·V(s_32) 自举"];
    i4 [label="λ-return 固定快照（γ0.99, λ0.95）\n梯度裁剪 1.0 / 逐元素 0.1 后 step 一次"];
    i5 [label="critic：179 维特征 × 8192×32 目标\n5 epoch × 4 minibatch（内部 4096 再分块）"];
    i1 -> i2 -> i3 -> i4 -> i5;
  }

  subgraph cluster_tail {
    label="D 记账、护栏与日志"; style="rounded,dashed"; color="#8a8a8a"; fontsize=10;
    t1 [label="统计：real_steps、imagined_steps、更新计数、\ntiming、ETA、real/imagined fps"];
    t2 [label="collapse guard：每 50 轮平均 falls\n连续 2 次 > 3 → 回滚 actor/critic，lr × 0.5"];
    t3 [label="TrainingLogger.record\n→ metrics.jsonl 每轮 + 终端每 log_interval"];
    t4 [label="iteration % save_interval == 0 → save\nmodel_N.pt + policy_N.{pt,onnx,json}"];
    t1 -> t2 -> t3 -> t4;
  }

  start -> c1;
  c5 -> gate;
  gate -> w1 [label="是"];
  gate -> t1 [label="否：model_not_ready=1"];
  w3 -> ctrl;
  ctrl -> i1 [label="是"];
  ctrl -> t1 [label="否：world-model only / actor 冻结"];
  i5 -> t1;
  t4 -> start [style=dashed, label="下一轮"];
}
