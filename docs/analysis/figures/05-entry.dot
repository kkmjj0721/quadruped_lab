digraph G {
  graph [rankdir=TB, nodesep=0.26, ranksep=0.30, fontname="Noto Sans CJK SC", fontsize=14,
         label="图5  训练与播放入口：从命令行到仿真、检查点与产物", labelloc="t"];
  node [fontname="Noto Sans CJK SC", fontsize=9, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#3f6fa8"];
  edge [fontname="Noto Sans CJK SC", fontsize=8, color="#4a4a4a"];

  subgraph cluster_train {
    label="scripts/train.py（task_id 以 Unitree-Go2-SuperMimic 开头 → SuperMimic 分支）"; style="rounded,dashed"; color="#8a8a8a";
    t0 [label="normalize_train_arguments\n兼容 --env.scene.num-envs / --agent.* / --gpu-ids 等别名", fillcolor="#fdf6e3"];
    t1 [label="SuperMimicTrainConfig\ndevice / num_envs / seed / max_iterations / save_interval\nlog_interval / imag_microbatch / critic_microbatch\nlog_root / experiment_name / run_name / --task-config / --resume / --model-only", fillcolor="#fdf6e3"];
    t2 [label="_validate_arguments → _resolve_task_config\n任务ID→flat|rough；JSON 快照可覆盖网络与预算；validate_config 校验"];
    t3 [label="launch_training\n建 logs/supermimic/go2_supermimic/<时间戳>/，写 run_config.json\n+ source_manifest.json + sources.zip（源码快照，防不可重建）"];
    t4 [label="make_go2_supermimic_runner\n→ Go2TransitionAdapter（环境/地形/课程/任务）\n→ Go2SingleActorRunner（actor/WM/critic/replay）\n→ task_config.json（config + spec_hash + geometry_hash + 源码 hash）"];
    t5 [label="runner.learn(max_iterations)\n每 save_interval 存 model_N.pt，末轮必存；同时 export_policy"];
    t0 -> t1 -> t2 -> t3 -> t4 -> t5;
  }

  subgraph cluster_play {
    label="scripts/play.py（--agent trained|zero|random）"; style="rounded,dashed"; color="#8a8a8a";
    p0 [label="trained 必须有 --checkpoint-file，打印\n[INFO] Loading checkpoint: <路径>；zero/random 不需要检查点"];
    p1 [label="load_playback_source\n要求同目录 task_config.json 完整（spec_hash、geometry_hash）\n格式必须是 supermimic_moe_v1；只允许覆盖 num_envs / add_noise / curriculum / DR"];
    p2 [label="make_playback\nplay=True：关噪声、关地形课程、关 DR；num_envs 默认 1\n还原检查点里的课程状态（_restore_curriculum）\n策略 = TorchScript policy.pt（history 225 → action 12）"];
    p3 [label="SuperMimicPlayEnv\n维护 5 帧历史；reset 时首帧重复；unwrapped 返回自身\n（原生 PlayEnv 假设观测是字典，这里换成任务侧 45 维帧）"];
    p4 [label="查看器：--viewer auto|native|viser\nauto：有 DISPLAY/WAYLAND_DISPLAY → native 否则 viser\n--video 且 trained → SuperMimicVideoRecorder 存 <run>/videos/play"];
    p0 -> p1 -> p2 -> p3 -> p4;
  }

  subgraph cluster_eval {
    label="评估与部署（不进入训练循环）"; style="rounded,dashed"; color="#8a8a8a";
    e1 [label="rl/evaluation.py  evaluate_policy\n四条固定命令（前/后/侧/偏航），32 环境 300 步\n输出 RMSE、摔倒率、存活、机身高度、动作 rms/max、TorchScript 对拍误差"];
    e2 [label="agents/supermimic/single/export.py\nexport_policy：policy_N.pt（TorchScript，B×225→B×12）\npolicy_N.onnx（动态 batch）+ policy_N.json 元数据"];
  }

  t5 -> e1 [style=dashed, label="读 model_N.pt"];
  t5 -> e2 [label="保存时自动导出"];
  e2 -> p2 [style=dotted, label="部署物"];
  p1 -> e1 [style=dotted, label="同样的快照校验"];
}
