digraph G {
  graph [rankdir=TB, nodesep=0.30, ranksep=0.36, fontname="Noto Sans CJK SC", fontsize=15,
         label="图1  Go2 SuperMimic 在本项目中的分层、数据流与文件归属", labelloc="t"];
  node [fontname="Noto Sans CJK SC", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#3f6fa8"];
  edge [fontname="Noto Sans CJK SC", fontsize=8, color="#4a4a4a"];

  subgraph cluster_cfg {
    label="① 配置层（唯一数值来源，可被 JSON / CLI 覆盖）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=11;
    cfg1 [label="Go2ReferenceCfg\nsrc/config/go2/go2_reference_supermimic_config.py\nenv / sim / reset / noise / control / collision\nterrain / DR / commands / reward / runner", fillcolor="#fdf6e3"];
    cfg2 [label="SuperMimicConfig + ExecutionConfig\nagents/supermimic/config.py\n回放、预热、窗口、想象、网络、优化、探索、护栏", fillcolor="#fdf6e3"];
  }

  subgraph cluster_task {
    label="② 任务层 src/tasks/locomotion/go2_supermimic（Go2 专属 MDP + 真实仿真）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=11;
    env  [label="go_supermimic_env_cfg.py\nMjLab 环境：场景/关节位置动作/重置事件/DR\n终止仅 time_out；commands、rewards、observations 全空"];
    ter  [label="mdp/terrains.py\nTerrainMap（11 族×4~5 级连通地图）\nTerrainSurface（可微高度查询，8192 点分块）"];
    task [label="mdp/reference_task.py + reference_state.py + reference_rewards.py + state_spec.py\n状态 70+3、观测 45、特权 179、模型输入 187、六项奖励、硬/软失败、回放事件"];
    cur  [label="mdp/curriculums.py\nCommandCurriculum（命令阶段/站立概率）\nTerrainCurriculum（同族等级升降）"];
    ad   [label="rl/transition_adapter.py  Go2TransitionAdapter\nstep：物理→终态复制→任务→奖励→课程→部分 reset"];
  }

  subgraph cluster_agent {
    label="③ 算法层 agents/supermimic（不含 Go2 规则，只认 TaskState 张量语义）"; style="rounded,dashed"; color="#8a8a8a"; fontsize=11;
    run  [label="runner.py  SuperMimicRunner\n采集 / 归档 / 调度 / 护栏 / 保存 / 续训"];
    rep  [label="buffer.py\nReplay（capacity×num_envs 环形）\nWindowArchive（稀有事件整窗）"];
    mdl  [label="policy.py + world_model.py\nMoeActor / Critic / WorldModel / RunningNorm"];
    lrn  [label="learner.py + imagine.py\nfit_model / improve / 32 步 BPTT / lambda-return"];
  }

  subgraph cluster_io {
    label="④ 入口、产物与部署"; style="rounded,dashed"; color="#8a8a8a"; fontsize=11;
    ent  [label="scripts/train.py（SuperMimic 分支）\nscripts/play.py（播放/录像）\nrl/training.py · rl/runner.py · rl/playback.py", fillcolor="#e8f5e9"];
    out  [label="logs/supermimic/go2_supermimic/<时间戳>/\nmodel_N.pt · events.out.tfevents.*\ntask_config.json\n（部署策略由 tools/export_supermimic_policy.py 显式导出）", fillcolor="#fff3e0"];
  }

  cfg1 -> env [style=dashed, label="装配"];
  cfg1 -> task [style=dashed];
  cfg2 -> run [style=dashed, label="预算"];
  env -> ad;
  ter -> task [label="地表高度/边界"];
  task -> ad [label="reward / observe / terminate"];
  cur -> ad [label="命令范围 / 出生地块"];
  ad -> task [label="read_physical"];
  ad -> run [label="EnvStep"];
  run -> rep -> lrn -> mdl;
  run -> mdl [label="前向采集"];
  lrn -> run [label="metrics"];
  ent -> run [label="make runner"];
  ent -> ad;
  run -> out;
  out -> ent [style=dotted, label="play 读快照"];
}
